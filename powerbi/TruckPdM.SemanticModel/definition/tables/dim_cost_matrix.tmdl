	partition dim_cost_matrix = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "dim_cost_matrix.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"actual", Int64.Type}, {"actual_label", type text}, {"predicted", Int64.Type}, {"predicted_label", type text}, {"cost", Int64.Type}, {"cell_type", type text}, {"is_late_or_missed", Int64.Type}}, "en-US")
				in
					#"Changed Type"

	annotation PBI_ResultType = Table

