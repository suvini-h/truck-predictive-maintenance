model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["DataFolder","dim_vehicle","dim_action","dim_cost_matrix","fact_snapshot_scores","shap_top_drivers","shap_global","survival_curves","logrank_by_spec","cox_hazard_ratios","reliability_key_numbers","calibration","policy_comparison","threshold_sweep","key_results"]

ref table dim_vehicle
ref table dim_action
ref table dim_cost_matrix
ref table fact_snapshot_scores
ref table shap_top_drivers
ref table shap_global
ref table survival_curves
ref table logrank_by_spec
ref table cox_hazard_ratios
ref table reliability_key_numbers
ref table calibration
ref table policy_comparison
ref table threshold_sweep
ref table key_results
ref table 'Miss Cost Multiplier'
ref table 'Workshop Slots'
ref table 'SEK per Cost Unit'
ref table Policy
ref table _Measures

ref cultureInfo en-US
